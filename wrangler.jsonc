{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "candlemate",
	"compatibility_date": "2026-09-11",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "candlemate"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"vars": {
		"NEXT_PUBLIC_SUPABASE_URL": "https://xttldmenzgqeprjnlzqt.supabase.co",
		"NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inh0dGxkbWVuemdxZXByam5senF0Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODkxNDM5MDYsImV4cCI6MjEwNDcxOTkwNn0.Xj9JzF7aEIA4KjxtAEafLRPGp_WrF6-AHv5jwgA7nZ4",
		"UPI_ID": "9552682389@ybl",
		"NEXT_PUBLIC_UPI_ID": "9552682389@ybl"
	}
}